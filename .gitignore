#ignore utility files
.DS_Store
~$*

#ignore python checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

#ignore visual paradigm backup files
*.vpp.bak*
*.vpp.*
__pycache__
.venv/

#ignore local databases
db.sqlite3

#ignore massive files
*.pptx

#ignore folders explicitly marked do-not-commit (any folder whose name ends "- do not commit")
*- do not commit/

#ignore local Claude Code settings (machine-specific, not shared config)
.claude/settings.local.json

#ignore the instructor's local environment at a module root (lecture demos + lab code)
/module-*/requirements.txt
