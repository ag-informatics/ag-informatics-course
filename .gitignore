#ignore ds_store
.DS_Store

#ignore python checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

#ignore visual paradigm backup files
*.vpp.bak*
*.vpp.*
__pycache__
.venv/

#ignore local databases
db.sqlite3

#ignore massive files
*.pptx

#ignore folders explicitly marked do-not-commit
archived releases - do not commit/
ankita reference docs - do not commit/

#ignore local Claude Code settings (machine-specific, not shared config)
.claude/settings.local.json